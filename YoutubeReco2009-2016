// ==UserScript==
// @name         YouTube Retro Recommendations (Remplacement Total - 100 Vidéos)
// @namespace    http://tampermonkey.net/
// @version      9.0
// @description  Remplace TOUTES les recommandations de l'accueil et de la sidebar par ~100 vidéos rétro (2009-2015)
// @author       Assistant
// @match        https://www.youtube.com/*
// @grant        GM_xmlhttpRequest
// @connect      www.youtube.com
// ==/UserScript==

(function() {
    'use strict';

    let lastUrl = location.href;
    let isFetching = false;

    // 1. Déterminer la recherche
    function getCleanSearchQuery() {
        if (window.location.pathname.startsWith('/watch')) {
            const titleEl = document.querySelector('#eow-title, h1.watch-title-container, h1.title, ytd-watch-metadata #title h1');
            let rawTitle = titleEl ? titleEl.textContent : document.title;

            let clean = rawTitle
                .replace(/- YouTube$/i, '')
                .replace(/\(original\)/gi, '')
                .replace(/[\(\)\[\]\|]/g, '')
                .trim();

            const words = clean.split(/\s+/).filter(w => w.length > 2 && !['video', 'sharing', 'official', 'hd', '4k', 'youtube'].includes(w.toLowerCase()));

            return words.slice(0, 3).join(' ') || "animation minecraft";
        } else {
            const homeTopics = [
                'animation minecraft gaming',
                'viral video classic funny',
                'vlog music parody 2011',
                'podcast lets play retro'
            ];
            return homeTopics[Math.floor(Math.random() * homeTopics.length)];
        }
    }

    // 2. Recherche YouTube unique
    function fetchSingleSearch(fullQuery) {
        return new Promise((resolve) => {
            const url = `https://www.youtube.com/results?search_query=${encodeURIComponent(fullQuery)}`;

            GM_xmlhttpRequest({
                method: "GET",
                url: url,
                onload: function(response) {
                    try {
                        const html = response.responseText;
                        const jsonMatch = html.match(/var ytInitialData = ({[\s\S]*?});<\/script>/) || html.match(/window\["ytInitialData"\] = ({[\s\S]*?});/);
                        if (!jsonMatch) { resolve([]); return; }

                        const data = JSON.parse(jsonMatch[1]);
                        const contents = data?.contents?.twoColumnSearchResultsRenderer?.primaryContents?.sectionListRenderer?.contents;
                        if (!contents) { resolve([]); return; }

                        let videoList = [];
                        for (let section of contents) {
                            const items = section?.itemSectionRenderer?.contents;
                            if (items) {
                                for (let item of items) {
                                    if (item.videoRenderer) {
                                        const vr = item.videoRenderer;
                                        if (vr.videoId) {
                                            videoList.push({
                                                id: vr.videoId,
                                                title: vr.title?.runs?.[0]?.text || "Vidéo",
                                                channel: vr.ownerText?.runs?.[0]?.text || "Chaîne",
                                                thumb: `https://i.ytimg.com/vi/${vr.videoId}/mqdefault.jpg`,
                                                published: vr.publishedTimeText?.simpleText || "2009-2015"
                                            });
                                        }
                                    }
                                }
                            }
                        }
                        resolve(videoList);
                    } catch (e) {
                        resolve([]);
                    }
                },
                onerror: function() { resolve([]); }
            });
        });
    }

    // 3. Multiples recherches en parallèle (~100 vidéos)
    async function fetch100RetroVideos(baseQuery) {
        const queries = [
            `${baseQuery} after:2008 before:2010`,
            `${baseQuery} after:2010 before:2012`,
            `${baseQuery} after:2012 before:2014`,
            `${baseQuery} after:2014 before:2016`,
            `${baseQuery} after:2008 before:2016`
        ];

        const resultsArray = await Promise.all(queries.map(q => fetchSingleSearch(q)));

        const seenIds = new Set();
        const uniqueVideos = [];

        for (let list of resultsArray) {
            for (let v of list) {
                if (v.id && !seenIds.has(v.id)) {
                    seenIds.add(v.id);
                    uniqueVideos.push(v);
                }
            }
        }

        return uniqueVideos.slice(0, 100);
    }

    // 4. Masquer TOUS les éléments natifs de la zone ciblée
    function hideOriginalVideos(container) {
        if (!container) return;
        Array.from(container.children).forEach(child => {
            if (!child.classList.contains('custom-api-recs-box')) {
                child.style.display = 'none';
            }
        });
    }

    // 5. Nettoyage des anciens blocs
    function clearAllExistingBoxes() {
        document.querySelectorAll('.custom-api-recs-box').forEach(el => el.remove());
    }

    // 6. Conteneur cible
    function getTargetContainer() {
        const isWatchPage = window.location.pathname.startsWith('/watch');

        if (isWatchPage) {
            return document.querySelector('#watch7-sidebar-contents, #watch7-sidebar-modules, #watch-related, #watch7-sidebar, #secondary #items, #secondary-inner');
        } else {
            return document.querySelector('#page-container, #feed, #feed-main-content, #contents, #primary, ytd-rich-grid-renderer');
        }
    }

    // 7. Injection et remplacement principal
    async function injectRecommendations() {
        const targetContainer = getTargetContainer();
        if (!targetContainer) return;

        // On masque en continu les vidéos d'origine
        hideOriginalVideos(targetContainer);

        if (isFetching || targetContainer.querySelector('.custom-api-recs-box')) return;

        isFetching = true;

        clearAllExistingBoxes();
        const mainContainer = document.createElement('div');
        mainContainer.className = 'custom-api-recs-box';

        const isWatchPage = window.location.pathname.startsWith('/watch');

        mainContainer.style.cssText = 'background: #fff; border: 1px solid #e2e2e2; padding: 12px; margin-bottom: 20px; font-family: Roboto, Arial, sans-serif; border-radius: 2px; width: 100%; box-sizing: border-box; display: block !important;';
        mainContainer.innerHTML = `<div style="font-size: 11px; color: #666;">⏳ Recherche et remplacement par ~100 vidéos rétro (2009-2015)...</div>`;

        targetContainer.prepend(mainContainer);

        try {
            const mainQuery = getCleanSearchQuery();
            const videos = await fetch100RetroVideos(mainQuery);

            if (!videos || videos.length === 0) {
                mainContainer.innerHTML = `<div style="color: #666; font-size: 11px;">Aucune vidéo rétro trouvée.</div>`;
                return;
            }

            let html = `<h3 style="margin: 0 0 10px 0; font-size: 14px; color: #333; font-weight: bold; border-bottom: 2px solid #cc0000; padding-bottom: 5px;">📻 Recommandations Rétro Exclusives (2009-2015) [${videos.length} vidéos]</h3>`;

            // Mode Sidebar (Watch) vs Mode Grille (Accueil)
            if (isWatchPage) {
                html += `<div style="display: flex; flex-direction: column; gap: 8px; max-height: calc(100vh - 120px); overflow-y: auto; padding-right: 4px;">`;
                videos.forEach(v => {
                    html += `
                        <a href="/watch?v=${v.id}" style="display: flex; gap: 8px; text-decoration: none; color: #333;">
                            <img src="${v.thumb}" style="width: 100px; height: 56px; object-fit: cover; flex-shrink: 0; border-radius: 2px;">
                            <div style="overflow: hidden;">
                                <div style="font-size: 11px; font-weight: bold; line-height: 1.2; max-height: 2.4em; overflow: hidden; color: #0033cc;">${v.title}</div>
                                <div style="font-size: 10px; color: #666; margin-top: 3px;">${v.channel}</div>
                                <div style="font-size: 10px; color: #cc0000; font-weight: bold;">${v.published}</div>
                            </div>
                        </a>
                    `;
                });
                html += `</div>`;
            } else {
                html += `<div style="display: flex; flex-wrap: wrap; gap: 12px; max-height: calc(100vh - 150px); overflow-y: auto; padding: 4px;">`;
                videos.forEach(v => {
                    html += `
                        <a href="/watch?v=${v.id}" style="display: flex; flex-direction: column; width: 175px; text-decoration: none; color: #333; background: #fdfdfd; border: 1px solid #e5e5e5; padding: 6px; border-radius: 2px;">
                            <img src="${v.thumb}" style="width: 100%; height: 98px; object-fit: cover; border-radius: 2px;">
                            <div style="margin-top: 6px; font-size: 11px; font-weight: bold; line-height: 1.2; height: 2.4em; overflow: hidden; color: #0033cc;">${v.title}</div>
                            <div style="font-size: 10px; color: #666; margin-top: 4px;">${v.channel}</div>
                            <div style="font-size: 10px; color: #cc0000; font-weight: bold; margin-top: 2px;">${v.published}</div>
                        </a>
                    `;
                });
                html += `</div>`;
            }

            mainContainer.innerHTML = html;

        } catch (e) {
            mainContainer.innerHTML = `<div style="color: #cc0000; font-size: 11px;">⚠️ Erreur lors du chargement.</div>`;
        } finally {
            isFetching = false;
        }
    }

    // 8. Surveillance constante pour éviter que YouTube ou 7ktTube ne réaffichent les vidéos d'origine
    function handleNavigation() {
        if (location.href !== lastUrl) {
            lastUrl = location.href;
            clearAllExistingBoxes();
            setTimeout(injectRecommendations, 800);
        }
    }

    window.addEventListener('yt-navigate-finish', () => {
        clearAllExistingBoxes();
        setTimeout(injectRecommendations, 800);
    });

    const observer = new MutationObserver(() => {
        const container = getTargetContainer();
        if (container) hideOriginalVideos(container);
        handleNavigation();
        injectRecommendations();
    });

    if (document.body) {
        observer.observe(document.body, { childList: true, subtree: true });
    }

    setTimeout(injectRecommendations, 1000);
})();
