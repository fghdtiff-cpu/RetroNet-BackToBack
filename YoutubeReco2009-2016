// ==UserScript==
// @name         YouTube Retro Recommendations (Masquage Absolu - Version 17.0)
// @namespace    http://tampermonkey.net/
// @version      17.0
// @description  Recommandations 2009-2015 avec défilement infini rétro. Masquage CSS instantané et absolu des vidéos modernes en bas de page.
// @author       Assistant
// @match        https://www.youtube.com/*
// @grant        GM_xmlhttpRequest
// @connect      www.youtube.com
// ==/UserScript==

(function() {
    'use strict';

    let lastUrl = location.href;
    let isFetching = false;
    let seenVideoIds = new Set();
    let scrollObserver = null;

    // Topics de secours pour alimenter le défilement infini sur l'accueil
    const RETRO_TOPICS = [
        'animation minecraft gaming',
        'viral video classic funny',
        'vlog music parody 2011',
        'podcast lets play retro',
        'machinima halo counter strike',
        'skate compilation fail 2010',
        'ytp parody 2009',
        'coD mw2 trickshot 2010',
        'amv anime music video 2008',
        'glitch easter egg gaming 2012',
        'retro review gameplay 2013',
        'unboxing tech 2011'
    ];

    // Injecter la feuille de style dynamique pour verrouiller le masquage bas de page
    const styleId = 'retro-recs-dynamic-style';
    if (!document.getElementById(styleId)) {
        const style = document.createElement('style');
        style.id = styleId;
        style.textContent = `
            /* Masque TOUT ce que YouTube injecte après notre bloc rétro (en bas de page) */
            body.retro-active-page .custom-api-recs-box ~ * {
                display: none !important;
            }
            /* Masque les indicateurs de chargement natifs de YouTube */
            body.retro-active-page ytd-continuation-item-renderer,
            body.retro-active-page ytd-rich-section-renderer {
                display: none !important;
            }
        `;
        (document.head || document.documentElement).appendChild(style);
    }

    // 1. Vérification de la page (Accueil ou Watch uniquement)
    function isValidPage() {
        const path = window.location.pathname;
        const isWatch = path.startsWith('/watch');
        const isHome = path === '/' || path === '' || path === '/index';
        return { isWatch, isHome, valid: isWatch || isHome };
    }

    // 2. Restauration complète lors d'une recherche
    function restoreOriginalVideos() {
        document.body.classList.remove('retro-active-page');
        clearAllExistingBoxes();
    }

    // 3. Activer le mode rétro (déclenche les règles CSS de masquage)
    function enableRetroMode() {
        const { valid } = isValidPage();
        if (valid) {
            document.body.classList.add('retro-active-page');
        } else {
            restoreOriginalVideos();
        }
    }

    // 4. Déterminer la requête de recherche de base
    function getCleanSearchQuery() {
        const { isWatch } = isValidPage();
        if (isWatch) {
            const titleEl = document.querySelector('#eow-title, .watch-title, h1.watch-title-container, h1.title, ytd-watch-metadata #title h1');
            let rawTitle = titleEl ? titleEl.textContent : document.title;

            let clean = rawTitle
                .replace(/- YouTube$/i, '')
                .replace(/\(original\)/gi, '')
                .replace(/[\(\)\[\]\|]/g, '')
                .trim();

            const words = clean.split(/\s+/).filter(w => w.length > 2 && !['video', 'sharing', 'official', 'hd', '4k', 'youtube'].includes(w.toLowerCase()));
            return words.slice(0, 3).join(' ') || "animation minecraft";
        } else {
            return RETRO_TOPICS[Math.floor(Math.random() * RETRO_TOPICS.length)];
        }
    }

    // 5. Recherche HTTP interne
    function fetchSingleSearch(fullQuery) {
        return new Promise((resolve) => {
            const url = `https://www.youtube.com/results?search_query=${encodeURIComponent(fullQuery)}`;

            GM_xmlhttpRequest({
                method: "GET",
                url: url,
                onload: function(response) {
                    try {
                        const html = response.responseText;
                        const jsonMatch = html.match(/var ytInitialData = ({[\s\S]*?});<\/script>/) || html.match(/window\["ytInitialData"\] = ({[\s\S]*?});/);
                        if (!jsonMatch) { resolve([]); return; }

                        const data = JSON.parse(jsonMatch[1]);
                        const contents = data?.contents?.twoColumnSearchResultsRenderer?.primaryContents?.sectionListRenderer?.contents;
                        if (!contents) { resolve([]); return; }

                        let videoList = [];
                        for (let section of contents) {
                            const items = section?.itemSectionRenderer?.contents;
                            if (items) {
                                for (let item of items) {
                                    if (item.videoRenderer) {
                                        const vr = item.videoRenderer;
                                        if (vr.videoId) {
                                            videoList.push({
                                                id: vr.videoId,
                                                title: vr.title?.runs?.[0]?.text || "Vidéo",
                                                channel: vr.ownerText?.runs?.[0]?.text || "Chaîne",
                                                thumb: `https://i.ytimg.com/vi/${vr.videoId}/mqdefault.jpg`,
                                                published: vr.publishedTimeText?.simpleText || "2009-2015"
                                            });
                                        }
                                    }
                                }
                            }
                        }
                        resolve(videoList);
                    } catch (e) {
                        resolve([]);
                    }
                },
                onerror: function() { resolve([]); }
            });
        });
    }

    // 6. Multi-requêtes rétro
    async function fetchRetroVideosBatch(baseQuery) {
        const querySuffixes = [
            'after:2008 before:2010',
            'after:2010 before:2012',
            'after:2012 before:2014',
            'after:2014 before:2016'
        ];

        const selectedQueries = querySuffixes.map(suffix => `${baseQuery} ${suffix}`);
        const resultsArray = await Promise.all(selectedQueries.map(q => fetchSingleSearch(q)));

        const newVideos = [];
        for (let list of resultsArray) {
            for (let v of list) {
                if (v.id && !seenVideoIds.has(v.id)) {
                    seenVideoIds.add(v.id);
                    newVideos.push(v);
                }
            }
        }
        return newVideos;
    }

    // 7. Nettoyage
    function clearAllExistingBoxes() {
        if (scrollObserver) {
            scrollObserver.disconnect();
            scrollObserver = null;
        }
        seenVideoIds.clear();
        document.querySelectorAll('.custom-api-recs-box').forEach(el => el.remove());
    }

    // 8. Conteneur cible
    function getTargetContainer() {
        const { isWatch, isHome } = isValidPage();

        if (isWatch) {
            return document.querySelector([
                '#watch7-sidebar-contents',
                '#watch7-sidebar-modules',
                '#watch-related',
                '#watch7-sidebar',
                '#watch-sidebar',
                '#secondary #items',
                '#secondary-inner',
                'ytd-watch-next-secondary-results-renderer'
            ].join(', '));
        } else if (isHome) {
            return document.querySelector([
                '#feed-main-content',
                '#feed-main-content-holder',
                '.feed-container',
                '#feed',
                '#page-container',
                '#contents',
                '#primary',
                'ytd-rich-grid-renderer'
            ].join(', '));
        }
        return null;
    }

    // 9. Correctif Autoplay Vorapis V3 & Redux
    function fixVorapisPlayerAutoplay() {
        if (!window.location.pathname.startsWith('/watch')) return;

        const attemptPlay = () => {
            const video = document.querySelector('video');
            const moviePlayer = document.getElementById('movie_player');

            if (video && video.paused && video.currentTime < 1) {
                if (moviePlayer && typeof moviePlayer.playVideo === 'function') {
                    moviePlayer.playVideo();
                } else {
                    video.play().catch(() => {});
                }
            }
        };

        attemptPlay();
        setTimeout(attemptPlay, 400);
        setTimeout(attemptPlay, 1000);
    }

    // 10. Rendu HTML d'une vidéo
    function renderVideoCard(v, isWatch) {
        if (isWatch) {
            return `
                <a href="/watch?v=${v.id}" style="display: flex !important; gap: 8px !important; text-decoration: none !important; color: #333 !important; background: transparent !important; border: none !important; margin: 0 !important; padding: 0 !important;">
                    <img src="${v.thumb}" style="width: 100px !important; height: 56px !important; object-fit: cover !important; flex-shrink: 0 !important; border-radius: 2px !important;">
                    <div style="overflow: hidden !important;">
                        <div style="font-size: 11px !important; font-weight: bold !important; line-height: 1.2 !important; max-height: 2.4em !important; overflow: hidden !important; color: #0033cc !important;">${v.title}</div>
                        <div style="font-size: 10px !important; color: #666 !important; margin-top: 3px !important;">${v.channel}</div>
                        <div style="font-size: 10px !important; color: #cc0000 !important; font-weight: bold !important;">${v.published}</div>
                    </div>
                </a>
            `;
        } else {
            return `
                <a href="/watch?v=${v.id}" style="display: flex !important; flex-direction: column !important; width: 100% !important; text-decoration: none !important; color: #333 !important; background: #fdfdfd !important; border: 1px solid #e5e5e5 !important; padding: 8px !important; border-radius: 3px !important; box-sizing: border-box !important;">
                    <img src="${v.thumb}" style="width: 100% !important; aspect-ratio: 16/9 !important; height: auto !important; object-fit: cover !important; border-radius: 2px !important;">
                    <div style="margin-top: 8px !important; font-size: 12px !important; font-weight: bold !important; line-height: 1.3 !important; height: 2.6em !important; overflow: hidden !important; color: #0033cc !important;">${v.title}</div>
                    <div style="font-size: 11px !important; color: #666 !important; margin-top: 4px !important;">${v.channel}</div>
                    <div style="font-size: 11px !important; color: #cc0000 !important; font-weight: bold !important; margin-top: 2px !important;">${v.published}</div>
                </a>
            `;
        }
    }

    // 11. Charger plus de vidéos lors du défilement infini
    async function loadMoreRetroVideos(itemsHolder, isWatch) {
        if (isFetching) return;
        isFetching = true;

        try {
            const nextQuery = getCleanSearchQuery();
            const newVideos = await fetchRetroVideosBatch(nextQuery);

            if (newVideos && newVideos.length > 0) {
                const fragment = document.createDocumentFragment();
                const tempDiv = document.createElement('div');

                tempDiv.innerHTML = newVideos.map(v => renderVideoCard(v, isWatch)).join('');

                while (tempDiv.firstChild) {
                    fragment.appendChild(tempDiv.firstChild);
                }
                itemsHolder.appendChild(fragment);
            }
        } catch (e) {
            // Silence
        } finally {
            isFetching = false;
        }
    }

    // 12. Injection principale
    async function injectRecommendations() {
        const { valid, isWatch } = isValidPage();

        if (!valid) {
            restoreOriginalVideos();
            return;
        }

        enableRetroMode();

        if (isWatch) {
            fixVorapisPlayerAutoplay();
        }

        const targetContainer = getTargetContainer();
        if (!targetContainer) return;

        if (isFetching || targetContainer.querySelector('.custom-api-recs-box')) return;

        isFetching = true;

        clearAllExistingBoxes();

        const mainContainer = document.createElement('div');
        mainContainer.className = 'custom-api-recs-box';
        mainContainer.style.cssText = 'background: transparent !important; padding: 0 !important; margin: 0 auto 20px auto !important; font-family: Roboto, Arial, sans-serif !important; width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; display: block !important; clear: both !important;';

        const itemsHolder = document.createElement('div');
        if (isWatch) {
            itemsHolder.style.cssText = 'display: flex !important; flex-direction: column !important; gap: 8px !important; padding-right: 4px !important;';
        } else {
            itemsHolder.style.cssText = 'display: grid !important; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)) !important; gap: 16px !important; width: 100% !important; box-sizing: border-box !important; padding: 4px 0 !important;';
        }

        const sentinel = document.createElement('div');
        sentinel.className = 'retro-scroll-sentinel';
        sentinel.style.cssText = 'height: 40px !important; width: 100% !important; clear: both !important;';

        mainContainer.appendChild(itemsHolder);
        mainContainer.appendChild(sentinel);

        // Le placer obligatoirement TOUT EN HAUT pour que la règle CSS ~ masque tout le reste
        targetContainer.prepend(mainContainer);

        try {
            const mainQuery = getCleanSearchQuery();
            const initialVideos = await fetchRetroVideosBatch(mainQuery);

            if (!initialVideos || initialVideos.length === 0) {
                itemsHolder.innerHTML = `<div style="color: #666; font-size: 11px; padding: 10px; background: #fff; border: 1px solid #ccc;">⚠️ Aucune vidéo rétro trouvée.</div>`;
                return;
            }

            itemsHolder.innerHTML = initialVideos.map(v => renderVideoCard(v, isWatch)).join('');

            // Observer de défilement pour charger davantage de vidéos rétro
            scrollObserver = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting) {
                    loadMoreRetroVideos(itemsHolder, isWatch);
                }
            }, { rootMargin: '600px' });

            scrollObserver.observe(sentinel);

        } catch (e) {
            itemsHolder.innerHTML = `<div style="color: #cc0000; font-size: 11px; padding: 10px; background: #fff; border: 1px solid #cc0000;">⚠️ Erreur lors du chargement des recommandations.</div>`;
        } finally {
            isFetching = false;
        }
    }

    // 13. Navigation et observateur DOM
    function handleNavigation() {
        if (location.href !== lastUrl) {
            lastUrl = location.href;
            const { valid } = isValidPage();
            if (!valid) {
                restoreOriginalVideos();
            } else {
                clearAllExistingBoxes();
                setTimeout(injectRecommendations, 800);
            }
        }
    }

    window.addEventListener('yt-navigate-finish', () => {
        const { valid } = isValidPage();
        if (!valid) {
            restoreOriginalVideos();
        } else {
            clearAllExistingBoxes();
            setTimeout(injectRecommendations, 800);
        }
    });

    const observer = new MutationObserver(() => {
        const { valid } = isValidPage();
        if (valid) {
            enableRetroMode();
            handleNavigation();
            injectRecommendations();
        } else {
            restoreOriginalVideos();
        }
    });

    if (document.body) {
        observer.observe(document.body, { childList: true, subtree: true });
    }

    const { valid } = isValidPage();
    if (valid) {
        setTimeout(injectRecommendations, 1000);
    } else {
        restoreOriginalVideos();
    }
})();
