// ==UserScript==
// @name         YouTube Retro Recommendations (Redux & V3 Vorapis Edition)
// @namespace    http://tampermonkey.net/
// @version      10.0
// @description  Remplace toutes les vidéos par ~100 recommandations 2009-2015, compatible avec YouTube Redux & V3 Vorapis
// @author       Assistant
// @match        https://www.youtube.com/*
// @grant        GM_xmlhttpRequest
// @connect      www.youtube.com
// ==/UserScript==

(function() {
    'use strict';

    let lastUrl = location.href;
    let isFetching = false;

    // 1. Déterminer le sujet de recherche (Compatible Vorapis / Redux)
    function getCleanSearchQuery() {
        if (window.location.pathname.startsWith('/watch')) {
            // Sélection élargie des titres pour Vorapis V3 / Redux / YouTube Moderne
            const titleEl = document.querySelector('#eow-title, .watch-title, h1.watch-title-container, h1.title, ytd-watch-metadata #title h1');
            let rawTitle = titleEl ? titleEl.textContent : document.title;

            let clean = rawTitle
                .replace(/- YouTube$/i, '')
                .replace(/\(original\)/gi, '')
                .replace(/[\(\)\[\]\|]/g, '')
                .trim();

            const words = clean.split(/\s+/).filter(w => w.length > 2 && !['video', 'sharing', 'official', 'hd', '4k', 'youtube'].includes(w.toLowerCase()));

            return words.slice(0, 3).join(' ') || "animation minecraft";
        } else {
            const homeTopics = [
                'animation minecraft gaming',
                'viral video classic funny',
                'vlog music parody 2011',
                'podcast lets play retro'
            ];
            return homeTopics[Math.floor(Math.random() * homeTopics.length)];
        }
    }

    // 2. Recherche HTTP interne sur YouTube
    function fetchSingleSearch(fullQuery) {
        return new Promise((resolve) => {
            const url = `https://www.youtube.com/results?search_query=${encodeURIComponent(fullQuery)}`;

            GM_xmlhttpRequest({
                method: "GET",
                url: url,
                onload: function(response) {
                    try {
                        const html = response.responseText;
                        const jsonMatch = html.match(/var ytInitialData = ({[\s\S]*?});<\/script>/) || html.match(/window\["ytInitialData"\] = ({[\s\S]*?});/);
                        if (!jsonMatch) { resolve([]); return; }

                        const data = JSON.parse(jsonMatch[1]);
                        const contents = data?.contents?.twoColumnSearchResultsRenderer?.primaryContents?.sectionListRenderer?.contents;
                        if (!contents) { resolve([]); return; }

                        let videoList = [];
                        for (let section of contents) {
                            const items = section?.itemSectionRenderer?.contents;
                            if (items) {
                                for (let item of items) {
                                    if (item.videoRenderer) {
                                        const vr = item.videoRenderer;
                                        if (vr.videoId) {
                                            videoList.push({
                                                id: vr.videoId,
                                                title: vr.title?.runs?.[0]?.text || "Vidéo",
                                                channel: vr.ownerText?.runs?.[0]?.text || "Chaîne",
                                                thumb: `https://i.ytimg.com/vi/${vr.videoId}/mqdefault.jpg`,
                                                published: vr.publishedTimeText?.simpleText || "2009-2015"
                                            });
                                        }
                                    }
                                }
                            }
                        }
                        resolve(videoList);
                    } catch (e) {
                        resolve([]);
                    }
                },
                onerror: function() { resolve([]); }
            });
        });
    }

    // 3. Multi-requêtes simultanées (~100 vidéos)
    async function fetch100RetroVideos(baseQuery) {
        const queries = [
            `${baseQuery} after:2008 before:2010`,
            `${baseQuery} after:2010 before:2012`,
            `${baseQuery} after:2012 before:2014`,
            `${baseQuery} after:2014 before:2016`,
            `${baseQuery} after:2008 before:2016`
        ];

        const resultsArray = await Promise.all(queries.map(q => fetchSingleSearch(q)));

        const seenIds = new Set();
        const uniqueVideos = [];

        for (let list of resultsArray) {
            for (let v of list) {
                if (v.id && !seenIds.has(v.id)) {
                    seenIds.add(v.id);
                    uniqueVideos.push(v);
                }
            }
        }

        return uniqueVideos.slice(0, 100);
    }

    // 4. Masquer toutes les vidéos originales avec priorité !important
    function hideOriginalVideos(container) {
        if (!container) return;
        Array.from(container.children).forEach(child => {
            if (!child.classList.contains('custom-api-recs-box')) {
                child.style.setProperty('display', 'none', 'important');
            }
        });
    }

    // 5. Nettoyage
    function clearAllExistingBoxes() {
        document.querySelectorAll('.custom-api-recs-box').forEach(el => el.remove());
    }

    // 6. Détection étendue du conteneur (Vorapis V3 + Redux + standard)
    function getTargetContainer() {
        const isWatchPage = window.location.pathname.startsWith('/watch');

        if (isWatchPage) {
            // Sélecteurs pour Vorapis V3, Redux et YouTube Moderne
            return document.querySelector([
                '#watch7-sidebar-contents',
                '#watch7-sidebar-modules',
                '#watch-related',
                '#watch7-sidebar',
                '#watch-sidebar',
                '#secondary #items',
                '#secondary-inner',
                'ytd-watch-next-secondary-results-renderer'
            ].join(', '));
        } else {
            // Sélecteurs d'accueil pour Vorapis V3, Redux et YouTube Moderne
            return document.querySelector([
                '#feed-main-content',
                '#feed-main-content-holder',
                '.feed-container',
                '#feed',
                '#page-container',
                '#contents',
                '#primary',
                'ytd-rich-grid-renderer'
            ].join(', '));
        }
    }

    // 7. Injection principale
    async function injectRecommendations() {
        const targetContainer = getTargetContainer();
        if (!targetContainer) return;

        hideOriginalVideos(targetContainer);

        if (isFetching || targetContainer.querySelector('.custom-api-recs-box')) return;

        isFetching = true;

        clearAllExistingBoxes();
        const mainContainer = document.createElement('div');
        mainContainer.className = 'custom-api-recs-box';

        const isWatchPage = window.location.pathname.startsWith('/watch');

        // Styles isolés pour ne pas se faire écraser par Vorapis V3 / Redux CSS
        mainContainer.style.cssText = 'background: #ffffff !important; border: 1px solid #e2e2e2 !important; padding: 12px !important; margin-bottom: 20px !important; font-family: Roboto, Arial, sans-serif !important; border-radius: 2px !important; width: 100% !important; box-sizing: border-box !important; display: block !important; clear: both !important;';
        mainContainer.innerHTML = `<div style="font-size: 11px; color: #666;">⏳ Recherche de ~100 vidéos rétro (2009-2015)...</div>`;

        targetContainer.prepend(mainContainer);

        try {
            const mainQuery = getCleanSearchQuery();
            const videos = await fetch100RetroVideos(mainQuery);

            if (!videos || videos.length === 0) {
                mainContainer.innerHTML = `<div style="color: #666; font-size: 11px;">Aucune vidéo rétro trouvée.</div>`;
                return;
            }

            let html = `<h3 style="margin: 0 0 10px 0 !important; font-size: 14px !important; color: #333 !important; font-weight: bold !important; border-bottom: 2px solid #cc0000 !important; padding-bottom: 5px !important; text-transform: none !important;">📻 Recommandations Rétro Exclusives (2009-2015) [${videos.length} vidéos]</h3>`;

            if (isWatchPage) {
                // Sidebar : Liste verticale avec barre de défilement
                html += `<div style="display: flex !important; flex-direction: column !important; gap: 8px !important; max-height: calc(100vh - 120px) !important; overflow-y: auto !important; padding-right: 4px !important;">`;
                videos.forEach(v => {
                    html += `
                        <a href="/watch?v=${v.id}" style="display: flex !important; gap: 8px !important; text-decoration: none !important; color: #333 !important; background: transparent !important; border: none !important; margin: 0 !important; padding: 0 !important;">
                            <img src="${v.thumb}" style="width: 100px !important; height: 56px !important; object-fit: cover !important; flex-shrink: 0 !important; border-radius: 2px !important;">
                            <div style="overflow: hidden !important;">
                                <div style="font-size: 11px !important; font-weight: bold !important; line-height: 1.2 !important; max-height: 2.4em !important; overflow: hidden !important; color: #0033cc !important;">${v.title}</div>
                                <div style="font-size: 10px !important; color: #666 !important; margin-top: 3px !important;">${v.channel}</div>
                                <div style="font-size: 10px !important; color: #cc0000 !important; font-weight: bold !important;">${v.published}</div>
                            </div>
                        </a>
                    `;
                });
                html += `</div>`;
            } else {
                // Accueil : Grille de cartes rétro
                html += `<div style="display: flex !important; flex-wrap: wrap !important; gap: 12px !important; max-height: calc(100vh - 150px) !important; overflow-y: auto !important; padding: 4px !important;">`;
                videos.forEach(v => {
                    html += `
                        <a href="/watch?v=${v.id}" style="display: flex !important; flex-direction: column !important; width: 165px !important; text-decoration: none !important; color: #333 !important; background: #fdfdfd !important; border: 1px solid #e5e5e5 !important; padding: 6px !important; border-radius: 2px !important;">
                            <img src="${v.thumb}" style="width: 100% !important; height: 92px !important; object-fit: cover !important; border-radius: 2px !important;">
                            <div style="margin-top: 6px !important; font-size: 11px !important; font-weight: bold !important; line-height: 1.2 !important; height: 2.4em !important; overflow: hidden !important; color: #0033cc !important;">${v.title}</div>
                            <div style="font-size: 10px !important; color: #666 !important; margin-top: 4px !important;">${v.channel}</div>
                            <div style="font-size: 10px !important; color: #cc0000 !important; font-weight: bold !important; margin-top: 2px !important;">${v.published}</div>
                        </a>
                    `;
                });
                html += `</div>`;
            }

            mainContainer.innerHTML = html;

        } catch (e) {
            mainContainer.innerHTML = `<div style="color: #cc0000; font-size: 11px;">⚠️ Erreur lors du chargement.</div>`;
        } finally {
            isFetching = false;
        }
    }

    // 8. Surveillance dynamique des changements de DOM
    function handleNavigation() {
        if (location.href !== lastUrl) {
            lastUrl = location.href;
            clearAllExistingBoxes();
            setTimeout(injectRecommendations, 800);
        }
    }

    window.addEventListener('yt-navigate-finish', () => {
        clearAllExistingBoxes();
        setTimeout(injectRecommendations, 800);
    });

    const observer = new MutationObserver(() => {
        const container = getTargetContainer();
        if (container) hideOriginalVideos(container);
        handleNavigation();
        injectRecommendations();
    });

    if (document.body) {
        observer.observe(document.body, { childList: true, subtree: true });
    }

    setTimeout(injectRecommendations, 1000);
})();
})();
